#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="${HOME}/.local/share/mise/shims:${HOME}/.local/bin:/usr/bin:${PATH}"
NODE="$(command -v node || true)"
if [[ -z ${NODE} ]]; then
  echo "rewind-record: node not found" >&2
  exit 1
fi
exec "$NODE" "$ROOT/scripts/rewind-record.js" "$@"
